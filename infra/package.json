{
  "name": "genvilla-blog-infrastructure",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && eslint bin lib",
    "format": "prettier --check .",
    "synth": "cdk synth --strict",
    "diff": "cdk diff",
    "deploy:foundation": "cdk deploy GenvillaBlogFoundation --exclusively --require-approval never",
    "deploy:prod": "cdk deploy GenvillaBlogProd --exclusively --require-approval never"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.267.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "aws-cdk": "2.1139.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-awscdk": "^4.4.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
